# LifeHub environment variables — copy to .env.local and fill in values.
# Never commit .env.local or any file containing real keys.

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project URL: Supabase Dashboard → Project Settings → API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…): Dashboard → Project Settings → API Keys.
# Safe for the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative for older projects (only used if the publishable key is empty).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute URL used in auth emails (confirmation, password reset).
# Local: http://localhost:3000 · Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public support address shown on /contact and /privacy.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Scheduled reminders (optional, server-only) ──────────────────────────────
# Secret key (sb_secret_…) — ONLY used by /api/cron/reminders. Never expose it to
# the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternative (only used if SUPABASE_SECRET_KEY is empty).
SUPABASE_SERVICE_ROLE_KEY=
# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# ── Reminder emails (optional, server-only) ──────────────────────────────────
# Resend API key and a sender on a domain you've verified in Resend.
# Leave empty to keep reminders in-app only.
RESEND_API_KEY=
EMAIL_FROM=

# ── Tests against a real Supabase project (optional) ─────────────────────────
# Use a separate TEST project — the suites create and delete users and data.
# RLS integration suite (tests/integration) and Playwright E2E (e2e/):
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
# Playwright: base URL of a running app wired to the TEST project.
E2E_BASE_URL=http://localhost:3000
